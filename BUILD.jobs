# BUILD.jobs — build the amber-store daemon with JOBS: fully offline & CGO-free,
# rebuilding the solid-js/vite admin UI from source with a hermetic musl Node
# (npm) and embedding the fresh ui/dist into the Go binary via go:embed.
#
#   jb run   --source <amber-store> --build-file BUILD.jobs -- daemon --help
#   jb image --source <amber-store> --build-file BUILD.jobs -o /tmp/amber-store.oci.tar
#
# Two toolchains, one recipe. No network, no C compiler: zeebo/blake3's SIMD is
# Go assembly (kept under CGO_ENABLED=0), esbuild is a static Go binary, and
# rollup ships a prebuilt linux-musl native already pinned in package-lock.json.
# The musl Node is dynamically linked, so the BUILD (not the output) stages the
# musl loader (hostmusl) + libgcc_s + libstdc++ (x64 only); the output binary is
# a static CGO-free executable with an empty runtime closure.

# Recipe-declared fetchers (JOBS 2026-07-10 design): plugins/fetchers are
# pinned here; plugin artifacts bundle their companion fetcher pins.
GOPLUGIN = fetcher(
    name   = "goplugin",
    url    = "https://github.com/jobs-build/plugin-go/archive/609b0656b29417aadad3cfebefbd824aaf11f5fb.tar.gz",
    sha256 = "dfd5dfe4171359cc0b30473ed023e28b198e3fdc659940a841629573a1f0a923",
)
NODEPLUGIN = fetcher(
    name   = "nodeplugin",
    url    = "https://github.com/jobs-build/plugin-node/archive/68f3b3b21a911d553fa657de847c6e3bee854b43.tar.gz",
    sha256 = "d5f5c76c0f1fca6c3c43672164020b60adc88a41559442befd8cb8eb109d8de5",
)
ALPINEAPK = fetcher(
    name   = "alpineapk",
    url    = "https://github.com/jobs-build/fetcher-alpineapk/archive/0a6a773a1247b7cab16f4dbb86facc0173a823d8.tar.gz",
    sha256 = "b457e2ce7b357b240e7c160a0e65a46630067c2580b6872876829d6f07c4d12c",
)

GO_SHA = {
    "amd64": "1153d3d50e0ac764b447adfe05c2bcf08e889d42a02e0fe0259bd47f6733ad7f",
    "arm64": "ef758ae7c6cf9267c9c0ef080b8965f453d89ab2d25d9eb22de4405925238768",
}
NODE = {
    "x64":   ("https://unofficial-builds.nodejs.org/download/release/v22.23.1/node-v22.23.1-linux-x64-musl.tar.gz",   "b04877cf19a1b2515cfd95a0eab8f357b2eaa065128c3b9da07b0b10efe2577c"),
    "arm64": ("https://unofficial-builds.nodejs.org/download/release/v22.23.1/node-v22.23.1-linux-arm64-musl.tar.gz", "e936285203461f05614bba13fb265ab64e5c63048b35514cec66ae9a1666a07b"),
}
# Alpine v3.22 libstdc++ — only the x64 musl Node needs it dynamically (arm64
# static-links it). sha256 of the .apk (from examples/rails-build).
LIBSTDCXX = ("14.2.0-r6", "939f7c99898f3e8154207a17f4acbe8bc40437e1bb1b43f5525620ca9e452a2e")

GOARCH   = {"linux/amd64": "amd64",  "linux/arm64": "arm64"}
NODEARCH = {"linux/amd64": "x64",    "linux/arm64": "arm64"}
MUSLARCH = {"linux/amd64": "x86_64", "linux/arm64": "aarch64"}

def plugins():
    return {
        "go":   imp(fetcher = GOPLUGIN,   params = {}),
        "node": imp(fetcher = NODEPLUGIN, params = {}),
    }

def build():
    goarch = GOARCH[platform]
    narch = NODEARCH[platform]
    march = MUSLARCH[platform]
    node_url, node_sha = NODE[narch]

    inputs = {
        "toolchain": imp(fetcher = "tarball+https", params = {
            "url": "https://go.dev/dl/go1.26.4.linux-" + goarch + ".tar.gz",
            "sha256": GO_SHA[goarch],
        }),
        "node": imp(fetcher = "tarball+https", params = {"url": node_url, "sha256": node_sha, "strip": 1}),
        # hostmusl vendors the musl loader from its per-platform fetcher ARTIFACT
        # (not an arch-specific URL), and node execs against it on the build's
        # platform — so pin the import to this build's platform, else an
        # imports-run-anywhere placement on the other-arch runner yields the wrong
        # loader (node: "required file not found").
        "musl": imp(fetcher = "hostmusl", params = {}, platform = platform),
    }

    # libstdc++ is a build-only dep for the x64 musl Node only.
    libstdcxx_stage = ""
    if march == "x86_64":
        inputs["libstdcxx"] = imp(fetcher = ALPINEAPK, params = {
            "branch": "v3.22", "repo": "main", "arch": march,
            "name": "libstdc++", "version": LIBSTDCXX[0], "sha256": LIBSTDCXX[1],
        })
        libstdcxx_stage = 'cp -dr "$(jq -r .libstdcxx <<<"$JOBS_DEPS")/." /'

    # Node UI deps: package-lock.json -> one npm tarball import per package.
    npms = plugins["node"](package_lock = source.read("cmd/amber-store/ui/package-lock.json"))
    npm_adds = []
    for i, n in enumerate(npms):
        k = "npm_%d" % i
        inputs[k] = n["input"]
        npm_adds.append('npm cache add "$(jq -r .%s <<<"$JOBS_DEPS")"/*.tgz' % k)

    # Go module deps: root go.sum -> one gomod import per module.
    mods = plugins["go"](go_sum = source.read("go.sum"))
    mod_copies = []
    for m in mods:
        name = "mod_" + m["path"].replace("/", "_").replace(".", "_").replace("-", "_")
        inputs[name] = m["input"]
        mod_copies.append('cp -dr "$(jq -r .' + name + ' <<<"$JOBS_DEPS")/." "$GOMODCACHE/"')

    script = """
set -e

# ===== 1. musl userland for the dynamically-linked Node =====================
musl="$(jq -r .musl <<<"$JOBS_DEPS")"
mkdir -p /lib /usr/lib
ln -sf "$musl/lib/ld-musl-MARCH.so.1" /lib/ld-musl-MARCH.so.1
ln -sf "$musl/lib/libgcc_s.so.1"      /lib/libgcc_s.so.1
export LD_LIBRARY_PATH="$musl/lib"
LIBSTDCXX_STAGE
# A real /usr/bin/env (the vendored static busybox, already on PATH) so the
# `#!/usr/bin/env node` bin-shims npm/vite ship resolve. It must be a binary, not
# a #!-script — Linux does not chain shebang interpreters. busybox dispatches on
# argv[0] (= "env") to its env applet, which execs `node` from PATH.
mkdir -p /usr/bin
ln -sf "$(command -v busybox)" /usr/bin/env

mkdir -p /build/node
cp -dr "$(jq -r .node <<<"$JOBS_DEPS")/." /build/node/
chmod -R u+w /build/node
export PATH="/build/node/bin:$PATH" HOME=/build
node --version
npm --version

# ===== 2. Node UI: offline npm install + vite build ========================
export npm_config_cache=/build/npmcache
export npm_config_offline=true
export npm_config_audit=false npm_config_fund=false npm_config_update_notifier=false
mkdir -p "$npm_config_cache"
NPM_ADDS
cd "$SRC/cmd/amber-store/ui"
rm -rf dist node_modules
npm ci --offline
npm run build
ls dist/index.html >/dev/null      # vite produced the embedded SPA

# ===== 3. Go daemon: offline module build, embedding the fresh ui/dist =====
export GOROOT=/build/goroot
mkdir -p "$GOROOT" "$out/bin"
cp -dr "$(jq -r .toolchain <<<"$JOBS_DEPS")/go/." "$GOROOT/"
export PATH="$GOROOT/bin:$PATH"
export GOMODCACHE=/build/gomodcache GOCACHE=/build/gocache GOPATH=/build/gopath
export GOPROXY=off GOSUMDB=off GOFLAGS=-mod=mod GOTOOLCHAIN=local CGO_ENABLED=0
mkdir -p "$GOMODCACHE/cache/download"
MOD_COPIES
chmod -R u+w "$GOROOT" "$GOMODCACHE" 2>/dev/null || true
cd "$SRC"
go build -o "$out/bin/amber-store" ./cmd/amber-store

cat > "$out/JOBS.entrypoint" <<'EOF'
{"command": "bin/amber-store", "args": [], "env": {}}
EOF
"""
    script = script.replace("MARCH", march)
    script = script.replace("LIBSTDCXX_STAGE", libstdcxx_stage)
    script = script.replace("NPM_ADDS", "\n".join(npm_adds))
    script = script.replace("MOD_COPIES", "\n".join(mod_copies))

    return struct(inputs = inputs, env = {}, script = script, runtime_deps = [])
